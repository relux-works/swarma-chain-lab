# Inspection template only. There is no launch script.
# Required DAEMON_URL and DB_DIRECTORY are deliberately absent.
COIN=Namecoin
NET=mainnet
DB_ENGINE=leveldb
CACHE_MB=128
SERVICES=
REPORT_SERVICES=
PEER_DISCOVERY=off
PEER_ANNOUNCE=
MAX_SESSIONS=2
MAX_SEND=10000000
MAX_RECV=1000000
INITIAL_CONCURRENT=1
LOG_LEVEL=warning
ANON_LOGS=1
