[Unit]
Description=Credential gateway
Requires=@BROKER_UNIT@
After=@BROKER_UNIT@
BindsTo=@BROKER_UNIT@

[Service]
Type=exec
User=@SERVICE_ACCOUNT@
WorkingDirectory=@PLATFORM_ROOT@/state/credential-gateway
ExecStart=@PLATFORM_ROOT@/credential-gateway/bin/credential-gateway -config %d/gateway-config
LoadCredential=gateway-config:@CONFIG_LOCATION@
Environment=GATEWAY_LISTENER=@PLATFORM_ROOT@/run/credential-gateway/@SERVICE_GENERATION@/gateway.sock
Environment=GATEWAY_SERVICE_GENERATION=@SERVICE_GENERATION@
UMask=0077
LimitCORE=0
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=@PLATFORM_ROOT@/state/credential-gateway @PLATFORM_ROOT@/run/credential-gateway/@SERVICE_GENERATION@
CapabilityBoundingSet=
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
ProtectProc=invisible
ProcSubset=pid
PrivateIPC=yes
RemoveIPC=yes
Restart=no

[Install]
WantedBy=multi-user.target
