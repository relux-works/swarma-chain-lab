[Unit]
Description=Experimental API-key lab credential gateway
Requires=@LAB_BROKER_UNIT@
After=@LAB_BROKER_UNIT@
BindsTo=@LAB_BROKER_UNIT@

[Service]
Type=exec
User=@SERVICE_ACCOUNT@
WorkingDirectory=@PLATFORM_ROOT@/state/credential-gateway
ExecStart=@PLATFORM_ROOT@/credential-gateway-lab/bin/credential-gateway-lab -config @LAB_GATEWAY_CONFIG@ -broker-config @LAB_BROKER_MAPPING@ -gateway-socket @PLATFORM_ROOT@/run/credential-gateway/@SERVICE_GENERATION@/gateway.sock -activation %d/activation -authority %d/authority -fence %d/fence -manager-floor %d/manager-floor -release-set %d/release-set
LoadCredential=activation:@LAB_ACTIVATION@
LoadCredential=authority:@LAB_AUTHORITY@
LoadCredential=fence:@LAB_START_FENCE@
LoadCredential=manager-floor:@LAB_MANAGER_FLOOR@
LoadCredential=release-set:@LAB_RELEASE_SET@
UMask=0077
LimitCORE=0
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=@PLATFORM_ROOT@/state/credential-gateway @PLATFORM_ROOT@/run/credential-gateway/@SERVICE_GENERATION@
CapabilityBoundingSet=
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
ProtectProc=invisible
ProcSubset=pid
PrivateIPC=yes
RemoveIPC=yes
Restart=no

[Install]
WantedBy=multi-user.target
