{
  "listen": "127.0.0.1:8080",
  "key_file": "/var/lib/notary-service/private/attestation.key",
  "rpc_endpoint": "http://127.0.0.1:18443",
  "rpc_credential_file": "/run/notary-service/rpc.cookie",
  "deployment_policy_file": "/etc/notary-service/deployment-policy.json",
  "limits": {
    "request_bytes": 65536,
    "requests_per_second": 10,
    "burst": 10,
    "timeout_ms": 3000,
    "concurrent": 2
  }
}
