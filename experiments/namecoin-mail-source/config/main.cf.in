# Source candidate only. Render per authority into an isolated lab image.
# No host service installation. Placeholders are required, not defaults.
compatibility_level = 3.11
myhostname = @MTA_HOST@
mydomain = @MAIL_DOMAIN@
myorigin = $mydomain
mydestination =
inet_protocols = ipv4
inet_interfaces = @MTA_IP@
mynetworks = 127.0.0.0/8
relayhost =
smtp_fallback_relay =
transport_maps =
default_transport = smtp
local_transport = error:local delivery disabled
virtual_transport = virtual
virtual_mailbox_domains = @MAIL_DOMAIN@
virtual_mailbox_base = /lab/mailbox
virtual_mailbox_maps = texthash:/lab/config/vmailbox
virtual_uid_maps = static:2000
virtual_gid_maps = static:2000
virtual_minimum_uid = 2000
alias_maps =
alias_database =
local_recipient_maps =
authorized_submit_users = labsubmit
smtpd_relay_restrictions = reject_unauth_destination
smtpd_recipient_restrictions = reject_unlisted_recipient
smtpd_sasl_auth_enable = no
disable_vrfy_command = yes
smtpd_tls_security_level = encrypt
smtpd_tls_cert_file = /lab/keys/provider.crt
smtpd_tls_key_file = /lab/keys/provider.key
smtp_tls_security_level = dane-only
# A message's TLS-Required: no header must not weaken mandatory DANE.
tls_required_enable = no
smtp_dns_support_level = dnssec
smtp_host_lookup = dns
smtp_dns_resolver_options =
ignore_mx_lookup_error = no
smtp_tls_policy_maps =
smtp_tls_CAfile =
smtp_tls_CApath =
smtp_tls_session_cache_database =
smtpd_tls_session_cache_database =
smtp_connection_cache_on_demand = no
smtp_connection_cache_destinations =
smtp_connection_reuse_time_limit = 1s
smtp_tls_loglevel = 1
smtpd_tls_loglevel = 1
smtp_connect_timeout = 5s
smtp_helo_timeout = 5s
smtp_starttls_timeout = 5s
minimal_backoff_time = 5s
maximal_backoff_time = 15s
queue_run_delay = 5s
maximal_queue_lifetime = 1h
bounce_queue_lifetime = 1h
message_size_limit = 65536
mailbox_size_limit = 1048576
queue_directory = /lab/queue
data_directory = /lab/data
config_directory = /lab/config
daemon_directory = /lab/postfix/libexec
command_directory = /lab/postfix/bin
meta_directory = /lab/postfix/meta
shlib_directory = no
mail_owner = postfix
setgid_group = postdrop
default_database_type = lmdb
default_cache_db_type = lmdb
smtp_sasl_auth_enable = no
