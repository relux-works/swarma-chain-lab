# All addresses and port 25 exist only in a separately admitted private namespace.
# No chroot: the entire image is already isolated; no host /etc or sockets.
# service type private unpriv chroot wakeup maxproc command
@MTA_IP@:25 inet n - n - 1 smtpd
pickup unix n - n 60 1 pickup
cleanup unix n - n - 1 cleanup
qmgr unix n - n 30 1 qmgr
rewrite unix - - n - 1 trivial-rewrite
bounce unix - - n - 1 bounce
defer unix - - n - 1 bounce
trace unix - - n - 1 bounce
smtp unix - - n - 1 smtp -o max_use=1
virtual unix - n n - 1 virtual
error unix - - n - 1 error
tlsmgr unix - - n 1000? 1 tlsmgr
showq unix n - n - 1 showq
